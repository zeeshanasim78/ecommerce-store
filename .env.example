# Copy this file to .env.local (development) or .env.production (shop server).
# Never commit the copies — they hold secrets. Every key the app reads is listed here.

# Path to the SQLite database file. Default: ./data/caidea.db
# DATABASE_PATH=./data/caidea.db

# --- Added in later milestones (leave blank until then) ---

# Milestone 4 — Better Auth. Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=
# The shop's public web address. Also used for the links in customer emails (v1.11) — on the live
# server set it to https://your-domain (no trailing slash), never http://localhost.
# BETTER_AUTH_URL=http://localhost:3000

# Optional: password for `npm run staff:create` (otherwise it asks on screen). Don't leave it in the file.
# STAFF_PASSWORD=

# Milestone 8 — protects /api/cron/* routes. Generate with: openssl rand -hex 32
# CRON_SECRET=

# Payments (v1.8) — change these at any time: edit this file, then restart the app. No code change needed.
# Cash on delivery is offered only for orders up to this many rupees (0 = never). Default 20000.
COD_MAX_ORDER_PKR=20000
# Accounts customers pay into (manual: they send the money, then enter the transaction ID).
# Leave a pair blank to stop offering that method. Replace the SAMPLE values before going live.
JAZZCASH_ACCOUNT_TITLE=Caidea Traders (SAMPLE)
JAZZCASH_ACCOUNT_NUMBER=0300-0000000
EASYPAISA_ACCOUNT_TITLE=Caidea Traders (SAMPLE)
EASYPAISA_ACCOUNT_NUMBER=0345-0000000
NAYAPAY_ACCOUNT_TITLE=
NAYAPAY_ACCOUNT_NUMBER=
BANK_NAME=Sample Bank
BANK_ACCOUNT_TITLE=Caidea Traders (SAMPLE)
# Pakistani IBAN, 24 characters, e.g. PK36SCBL0000001123456702. The check digits are verified (v1.9):
# one mistyped character switches bank transfer off and Admin → Shop settings says why.
BANK_IBAN=PK56SAMP0000000000000000

# Email (v1.10) — ALL email from the shop goes through ONE Gmail account over smtp.gmail.com (port 465, TLS).
# Use a Gmail account made just for the shop, not a personal one. Free Gmail sends to ~500 recipients a day;
# going over blocks sending for up to 24 hours, so the app counts recipients and stops at GMAIL_DAILY_LIMIT.
GMAIL_USER=
# Name shown as the sender
GMAIL_FROM_NAME=Caidea
# How the app signs in to Gmail: app_password (simplest, recommended) or oauth2
GMAIL_AUTH=app_password
# app_password: turn on 2-Step Verification for the account, then Google Account → Security → App passwords →
# create one named "Caidea". Paste the 16 letters (spaces are fine). Changing the Gmail password cancels it.
GMAIL_APP_PASSWORD=
# oauth2 (optional, instead of an app password): a Google Cloud project with the Gmail API enabled, an OAuth
# client ("Web application"), and a refresh token for GMAIL_USER with the scope https://mail.google.com/
# (e.g. from Google's OAuth 2.0 Playground). Set the OAuth consent screen to "In production": while it is
# "Testing", Google expires the refresh token after 7 days.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Recipients per day for ordinary mail (max 500). Security alerts may use the rest of Gmail's 500.
GMAIL_DAILY_LIMIT=450
# Who gets security alerts (payment details changed, test emails). One or more, separated by commas.
ALERT_EMAIL_TO=
# Automated tests only: send to a mail server on THIS machine instead of Gmail. Must be blank on the live server.
EMAIL_TEST_SMTP=

# Milestone 10 — courier APIs (sandbox keys first)
# LEOPARDS_API_KEY=
# LEOPARDS_API_PASSWORD=
# POSTEX_API_TOKEN=

# Milestone 14 — payment aggregator (vendor to be chosen)
# AGGREGATOR_MERCHANT_ID=
# AGGREGATOR_SECRET_KEY=
